# ── Минимум для локального запуска (pnpm dev:db → pnpm bootstrap → pnpm dev) ──

# PostgreSQL — совпадает с infra/docker-compose.dev.yml
DATABASE_URL=postgresql://decentral_hub:decentral_hub@localhost:5432/decentral_hub

# API-сервер
PORT=8080

# Web (Vite) — отдельный порт, не путать с PORT API
WEB_PORT=5000
BASE_PATH=/
API_PROXY_TARGET=http://localhost:8080

# Секреты — setup сгенерирует автоматически, если пусто
WALLET_ENCRYPTION_KEY=
JWT_SECRET=
ADMIN_SECRET=change-me-local-dev

NODE_ENV=development

# ── Опционально (можно настроить позже) ─────────────────────────────────────

# REDIS_URL=redis://localhost:6379
# TURN_SECRET=
# TURN_URLS=
# VIRUSTOTAL_API_KEY=
# DEFAULT_OBJECT_STORAGE_BUCKET_ID=
# PRIVATE_OBJECT_DIR=
# PUBLIC_OBJECT_SEARCH_PATHS=
# DATABASE_URL_TEST=postgresql://test:test@localhost:5432/decentralhub_test
