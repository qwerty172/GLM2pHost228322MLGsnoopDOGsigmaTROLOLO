# ── Обязательно для локального dev ───────────────────────────────────────────
# Docker Postgres (pnpm dev:db): postgresql://decentral_hub:decentral_hub@localhost:5432/decentral_hub
DATABASE_URL=postgresql://decentral_hub:decentral_hub@localhost:5432/decentral_hub

PORT=8080
WEB_PORT=5000
BASE_PATH=/
API_PROXY_TARGET=http://localhost:8080

# Генерируются автоматически при pnpm setup
WALLET_ENCRYPTION_KEY=
JWT_SECRET=
ADMIN_SECRET=local-dev-admin

NODE_ENV=development

