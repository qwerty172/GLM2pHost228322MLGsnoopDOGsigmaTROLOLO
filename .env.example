# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (создай базу: createdb decentral_hub)
DATABASE_URL=postgresql://user:password@localhost:5432/decentral_hub

# ── API Server ────────────────────────────────────────────────────────────────
# Порт API-сервера (по умолчанию 8080)
PORT=8080

# ── Web (Vite dev) ────────────────────────────────────────────────────────────
# Web использует отдельный порт — не путать с PORT API выше.
# При запуске web: PORT=5000 BASE_PATH=/ pnpm --filter @workspace/web run dev
# Или через scripts/dev-local.sh (см. README)
WEB_PORT=5000
BASE_PATH=/

# URL API для Vite-прокси (локально — api-server на 8080)
API_PROXY_TARGET=http://localhost:8080

# ── Object Storage ────────────────────────────────────────────────────────────
# Replit Object Storage (локально можно оставить пустым — storage-роуты должны деградировать)
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# ── Security ──────────────────────────────────────────────────────────────────
# AES-256 ключ для шифрования адресов кошелька (32 байта hex)
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WALLET_ENCRYPTION_KEY=

# Секрет для admin-роутов (заголовок X-Admin-Secret)
ADMIN_SECRET=change-me-local-dev

# ── Virus Scanning ────────────────────────────────────────────────────────────
VIRUSTOTAL_API_KEY=

# ── Node ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
