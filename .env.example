# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/decentral_hub

# ── Server ────────────────────────────────────────────────────────────────────
# Port for the API server (default: 8080)
PORT=8080

# ── Object Storage ────────────────────────────────────────────────────────────
# Replit Object Storage bucket ID (for game assets, avatars, etc.)
DEFAULT_OBJECT_STORAGE_BUCKET_ID=

# Private storage path prefix
PRIVATE_OBJECT_DIR=private

# Public search paths (comma-separated)
PUBLIC_OBJECT_SEARCH_PATHS=public

# ── Security ──────────────────────────────────────────────────────────────────
# AES-256 key for wallet address encryption (32-byte hex string)
WALLET_ENCRYPTION_KEY=

# ── Virus Scanning ────────────────────────────────────────────────────────────
# VirusTotal API key (for scanning uploaded game files)
VIRUSTOTAL_API_KEY=

# ── Node ──────────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── WebRTC / TURN (coturn) ────────────────────────────────────────────────────
# Shared secret for time-limited TURN credentials (HMAC-SHA1, coturn use-auth-secret).
# Must match static-auth-secret in infra/coturn/turnserver.conf.
TURN_SECRET=

# Comma-separated TURN/STUN URLs served to clients via GET /api/public/ice-config.
# Example: turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_URLS=

# Legacy static TURN credentials (used when TURN_SECRET is unset):
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ── Redis ─────────────────────────────────────────────────────────────────────
# When set, rate-limit, signaling pub/sub, token storage, and catalog cache use Redis.
# Falls back to PostgreSQL / in-memory when unset or unreachable.
REDIS_URL=redis://localhost:6379

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# HS256 secret for access/refresh JWT signing. Generate with: openssl rand -hex 32
JWT_SECRET=

# ── Native capture (host agent) ───────────────────────────────────────────────
# Set USE_RAW_INPUT=1 in the host agent to register Raw Input API fallback.
USE_RAW_INPUT=
