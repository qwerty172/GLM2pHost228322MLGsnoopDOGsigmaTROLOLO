# ══════════════════════════════════════════════════════════════════════════════
# DecentralHub — минимум для локального запуска (остальное — на потом)
# ══════════════════════════════════════════════════════════════════════════════

# ── Обязательно ─────────────────────────────────────────────────────────────

# PostgreSQL 16. Вариант A — Docker (рекомендуется):
#   docker compose -f infra/docker-compose.dev.yml up -d postgres
DATABASE_URL=postgresql://decentral_hub:decentral_hub@localhost:5432/decentral_hub

# Вариант B — локальный Postgres:
# DATABASE_URL=postgresql://postgres:ВАШ_ПАРОЛЬ@localhost:5432/decentral_hub

# Порт API-сервера
PORT=8080

# AES-256 ключ кошелька (32 байта hex). setup-local.sh сгенерирует, если пусто.
WALLET_ENCRYPTION_KEY=

# ── Web (Vite dev) ────────────────────────────────────────────────────────────

WEB_PORT=5000
BASE_PATH=/
API_PROXY_TARGET=http://localhost:8080

# ── Локальная разработка ──────────────────────────────────────────────────────

NODE_ENV=development
ADMIN_SECRET=change-me-local-dev

# JWT для новой auth-схемы. setup-local.sh сгенерирует, если пусто.
JWT_SECRET=

# ══════════════════════════════════════════════════════════════════════════════
# Опционально — можно на потом (для продакшена / масштабирования / WebRTC NAT)
# ══════════════════════════════════════════════════════════════════════════════

# Redis — rate limit, pub/sub, кэш (без него — in-memory / PostgreSQL fallback)
# REDIS_URL=redis://localhost:6379

# TURN/STUN для WebRTC через NAT (локально в LAN часто не нужен)
# TURN_SECRET=
# TURN_URLS=turn:turn.example.com:3478

# Replit Object Storage (локально можно оставить пустым)
# DEFAULT_OBJECT_STORAGE_BUCKET_ID=
# PRIVATE_OBJECT_DIR=
# PUBLIC_OBJECT_SEARCH_PATHS=

# VirusTotal, Sentry — только для продакшена
# VIRUSTOTAL_API_KEY=
# VITE_SENTRY_DSN=
# SENTRY_DSN=

# CI / интеграционные тесты
# DATABASE_URL_TEST=postgresql://test:test@localhost:5432/decentralhub_test
