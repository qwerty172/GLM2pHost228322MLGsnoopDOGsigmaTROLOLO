# ── Database ──────────────────────────────────────────────────────────────────
# Локально через Docker (scripts/setup-local.sh подставит сам):
#   docker compose -f infra/docker-compose.dev.yml up -d postgres
DATABASE_URL=postgresql://decentral_hub:decentral_hub@localhost:5432/decentral_hub

# ── API Server ────────────────────────────────────────────────────────────────
# Порт API-сервера (по умолчанию 8080)
PORT=8080

# Опционально: Redis для shared rate limit при горизонтальном масштабировании.
# Без REDIS_URL используется in-memory limiter (один процесс API).
# REDIS_URL=redis://127.0.0.1:6379

# ── Web (Vite dev) ────────────────────────────────────────────────────────────
# Web использует WEB_PORT (не PORT API). dev-local.sh выставляет WEB_PORT=5000.
WEB_PORT=5000
BASE_PATH=/

# URL API для Vite-прокси (локально — api-server на 8080)
API_PROXY_TARGET=http://localhost:8080

# ── Object Storage ────────────────────────────────────────────────────────────
# Replit Object Storage (локально можно оставить пустым — storage-роуты должны деградировать)
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# ── Security ──────────────────────────────────────────────────────────────────
# AES-256 ключ для шифрования адресов кошелька (32 байта hex)
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WALLET_ENCRYPTION_KEY=

# Секрет для admin-роутов (заголовок X-Admin-Secret)
ADMIN_SECRET=change-me-local-dev

# ── Virus Scanning ────────────────────────────────────────────────────────────
VIRUSTOTAL_API_KEY=

# ── Node ──────────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── WebRTC / TURN (coturn) ────────────────────────────────────────────────────
# Shared secret for time-limited TURN credentials (HMAC-SHA1, coturn use-auth-secret).
# Must match static-auth-secret in infra/coturn/turnserver.conf.
TURN_SECRET=

# Comma-separated TURN/STUN URLs served to clients via GET /api/public/ice-config.
# Example: turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_URLS=

# Legacy static TURN credentials (used when TURN_SECRET is unset):
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ── Redis (опционально) ───────────────────────────────────────────────────────
# Без REDIS_URL используется in-memory / PostgreSQL fallback — для локалки достаточно.
# REDIS_URL=redis://127.0.0.1:6379

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# HS256 secret for access/refresh JWT signing. Generate with: openssl rand -hex 32
JWT_SECRET=

# ── Observability ─────────────────────────────────────────────────────────────
# VITE_SENTRY_DSN=   # optional — browser error reporting (web build)
# SENTRY_DSN=        # optional — api-server / host-agent (Node/Electron)

# ── Database migrations (existing DBs) ───────────────────────────────────────
# Fresh install: pnpm --filter @workspace/db run push
# Existing prod DB: apply lib/db/drizzle/manual_p2_delta_for_existing_db.sql once
# Do NOT run full 0000 migration on a live database.

# ── CI / integration tests ────────────────────────────────────────────────────
# DATABASE_URL_TEST=postgresql://test:test@localhost:5432/decentralhub_test
