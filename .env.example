# ── Сразу нужно (локальная разработка) ───────────────────────────────────────
# Docker Postgres из infra/docker-compose.dev.yml (pnpm dev:db):
DATABASE_URL=postgresql://decentral_hub:decentral_hub@localhost:5432/decentral_hub

PORT=8080
WEB_PORT=5000
BASE_PATH=/
API_PROXY_TARGET=http://localhost:8080
NODE_ENV=development

# Генерируются автоматически при pnpm setup, если пустые:
WALLET_ENCRYPTION_KEY=
JWT_SECRET=

ADMIN_SECRET=change-me-local-dev

# ── Опционально (можно настроить потом) ──────────────────────────────────────
# REDIS_URL=redis://127.0.0.1:6379
# TURN_SECRET=
# TURN_URLS=
# TURN_URL=
# TURN_USERNAME=
# TURN_CREDENTIAL=
# VIRUSTOTAL_API_KEY=
# DEFAULT_OBJECT_STORAGE_BUCKET_ID=
# PRIVATE_OBJECT_DIR=
# PUBLIC_OBJECT_SEARCH_PATHS=
# VITE_SENTRY_DSN=
# SENTRY_DSN=
# DATABASE_URL_TEST=postgresql://test:test@localhost:5432/decentralhub_test
