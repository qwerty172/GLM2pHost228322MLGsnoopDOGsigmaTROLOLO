# ══════════════════════════════════════════════════════════════════════════════
# СЕЙЧАС — минимум для локального dev (pnpm quickstart подставит секреты сам)
# ══════════════════════════════════════════════════════════════════════════════

# PostgreSQL. Дефолт совпадает с infra/docker-compose.dev.yml (pnpm infra:up)
DATABASE_URL=postgresql://decentral_hub:decentral_hub@localhost:5432/decentral_hub

PORT=8080
WEB_PORT=5000
BASE_PATH=/
API_PROXY_TARGET=http://localhost:8080
NODE_ENV=development

# Генерируются автоматически при pnpm setup (оставь пустым)
WALLET_ENCRYPTION_KEY=
JWT_SECRET=

ADMIN_SECRET=change-me-local-dev

# Redis — поднимается вместе с postgres через pnpm infra:up
REDIS_URL=redis://localhost:6379

# ══════════════════════════════════════════════════════════════════════════════
# ПОТОМ — когда нужны storage, WebRTC за NAT, прод, CI
# ══════════════════════════════════════════════════════════════════════════════

# Object Storage (Replit / GCS — без них storage-роуты деградируют)
# DEFAULT_OBJECT_STORAGE_BUCKET_ID=
# PRIVATE_OBJECT_DIR=
# PUBLIC_OBJECT_SEARCH_PATHS=

# TURN/coturn для WebRTC за NAT (infra/coturn, pnpm infra:up не включает coturn)
# TURN_SECRET=
# TURN_URLS=turn:localhost:3478
# TURN_URL=
# TURN_USERNAME=
# TURN_CREDENTIAL=

# VirusTotal для сканирования загрузок
# VIRUSTOTAL_API_KEY=

# Observability
# VITE_SENTRY_DSN=
# SENTRY_DSN=

# CI / integration tests
# DATABASE_URL_TEST=postgresql://test:test@localhost:5432/decentralhub_test

# ── Подсказки ─────────────────────────────────────────────────────────────────
# Fresh install:  pnpm quickstart   (docker + setup + dev)
# Уже настроен:   pnpm go           (API :8080 + Web :5000)
# БД в Docker:    pnpm infra:up
# Полный setup:   pnpm setup:full   (с typecheck)
# Smoke API:      pnpm smoke
# OpenAPI codegen: pnpm --filter @workspace/api-spec run codegen
