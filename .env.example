# ══════════════════════════════════════════════════════════════════════════════
# Минимум для локального старта:  pnpm dev:db  →  pnpm setup  →  pnpm dev
# Подробнее: QUICKSTART.md
# ══════════════════════════════════════════════════════════════════════════════

# PostgreSQL (совпадает с infra/docker-compose.dev.yml при pnpm dev:db)
DATABASE_URL=postgresql://decentral_hub:decentral_hub@localhost:5432/decentral_hub

# API-сервер
PORT=8080

# Web (Vite dev) — отдельный порт, не путать с PORT API
WEB_PORT=5000
BASE_PATH=/
API_PROXY_TARGET=http://localhost:8080

# Секреты — оставьте пустыми, pnpm setup сгенерирует автоматически
WALLET_ENCRYPTION_KEY=
JWT_SECRET=
ADMIN_SECRET=change-me-local-dev

NODE_ENV=development

# ══════════════════════════════════════════════════════════════════════════════
# Опционально — можно настроить позже
# ══════════════════════════════════════════════════════════════════════════════

# Redis (без него API работает в in-memory режиме на одном процессе)
# REDIS_URL=redis://localhost:6379

# Object Storage (локально можно оставить пустым)
# DEFAULT_OBJECT_STORAGE_BUCKET_ID=
# PRIVATE_OBJECT_DIR=
# PUBLIC_OBJECT_SEARCH_PATHS=

# VirusTotal
# VIRUSTOTAL_API_KEY=

# WebRTC / TURN (coturn) — pnpm dev:infra поднимает coturn
# TURN_SECRET=
# TURN_URLS=
# TURN_URL=
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Observability
# VITE_SENTRY_DSN=
# SENTRY_DSN=

# CI / integration tests
# DATABASE_URL_TEST=postgresql://test:test@localhost:5432/decentralhub_test
