# ── Быстрый старт (локально) ─────────────────────────────────────────────────
# 1. pnpm db:up     — PostgreSQL в Docker (если нет своей БД)
# 2. pnpm setup     — .env + секреты + install + db push
# 3. pnpm dev       — API :8080 + Web :5000
# 4. pnpm smoke     — проверка API (когда dev запущен)
#
# На потом: Redis, TURN, object storage, VirusTotal — см. секции ниже.

# ── Database ──────────────────────────────────────────────────────────────────
# Docker (pnpm db:up): postgresql://decentral_hub:decentral_hub@localhost:5432/decentral_hub
# Свой Postgres: createdb decentral_hub и подставь свои user/password
DATABASE_URL=postgresql://decentral_hub:decentral_hub@localhost:5432/decentral_hub

# ── API Server ────────────────────────────────────────────────────────────────
PORT=8080

# ── Web (Vite dev) ────────────────────────────────────────────────────────────
# WEB_PORT — порт браузера. PORT выше — только API (не путать!).
WEB_PORT=5000
BASE_PATH=/
API_PROXY_TARGET=http://localhost:8080

# ── Security (setup сгенерирует пустые значения) ─────────────────────────────
WALLET_ENCRYPTION_KEY=
JWT_SECRET=
ADMIN_SECRET=change-me-local-dev

# ── Node ──────────────────────────────────────────────────────────────────────
NODE_ENV=development

# ══════════════════════════════════════════════════════════════════════════════
# Ниже — опционально. Для локальной разработки можно не трогать.
# ══════════════════════════════════════════════════════════════════════════════

# ── Redis (опционально; без него — in-memory / PostgreSQL fallback) ───────────
# pnpm db:up:all поднимет Redis. Или раскомментируй:
# REDIS_URL=redis://127.0.0.1:6379

# ── Object Storage ────────────────────────────────────────────────────────────
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# ── Virus Scanning ────────────────────────────────────────────────────────────
VIRUSTOTAL_API_KEY=

# ── WebRTC / TURN (coturn) ────────────────────────────────────────────────────
# pnpm db:up:all поднимет coturn. Для продакшена — настрой TURN_URLS + TURN_SECRET.
TURN_SECRET=
TURN_URLS=
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ── Observability ─────────────────────────────────────────────────────────────
# VITE_SENTRY_DSN=
# SENTRY_DSN=

# ── CI / integration tests ────────────────────────────────────────────────────
# DATABASE_URL_TEST=postgresql://test:test@localhost:5432/decentralhub_test

# ── Миграции ──────────────────────────────────────────────────────────────────
# Fresh install: pnpm setup (или pnpm --filter @workspace/db run push)
# Existing prod DB: lib/db/drizzle/manual_p2_delta_for_existing_db.sql
