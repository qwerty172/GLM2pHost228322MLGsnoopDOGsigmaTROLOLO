{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "up": "node -e \"require('child_process').execSync(process.platform==='win32'?'scripts\\\\infra-up.bat':'./scripts/infra-up.sh',{stdio:'inherit',shell:true})\"",
    "setup": "node -e \"require('child_process').execSync(process.platform==='win32'?'scripts\\\\setup-local.bat':'./scripts/setup-local.sh',{stdio:'inherit',shell:true})\"",
    "dev": "node -e \"require('child_process').execSync(process.platform==='win32'?'scripts\\\\dev-local.bat':'./scripts/dev-local.sh',{stdio:'inherit',shell:true})\"",
    "quickstart": "node -e \"require('child_process').execSync(process.platform==='win32'?'scripts\\\\setup-local.bat && scripts\\\\dev-local.bat':'./scripts/quickstart.sh',{stdio:'inherit',shell:true})\"",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test": "pnpm --filter @workspace/api-server test",
    "smoke:invite": "node scripts/invite-flow-smoke.mjs",
    "smoke:features": "node scripts/features-smoke.mjs"
  },
  "private": true,
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  },
  "pnpm": {
    "overrides": {
      "js-yaml": "4.1.1"
    }
  }
}
