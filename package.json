{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "go": "bash scripts/dev-local.sh",
    "dev": "bash scripts/dev-local.sh",
    "setup": "bash scripts/setup-local.sh",
    "setup:full": "SETUP_SKIP_TYPECHECK=0 bash scripts/setup-local.sh",
    "quickstart": "bash scripts/quickstart.sh",
    "infra:up": "bash scripts/infra-up.sh",
    "infra:down": "bash scripts/infra-down.sh",
    "smoke": "bash scripts/smoke-api.sh",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test": "pnpm --filter @workspace/api-server test",
    "smoke:invite": "node scripts/invite-flow-smoke.mjs",
    "smoke:features": "node scripts/features-smoke.mjs"
  },
  "private": true,
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  },
  "pnpm": {
    "overrides": {
      "js-yaml": "4.1.1"
    }
  }
}
