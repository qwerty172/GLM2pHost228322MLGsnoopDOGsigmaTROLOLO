# Готовый .env для локальной разработки с Docker (infra/docker-compose.dev.yml).
# Скопируй: cp .env.docker .env  — или запусти: pnpm quickstart

# ── Database (postgres service) ───────────────────────────────────────────────
DATABASE_URL=postgresql://decentral_hub:decentral_hub@localhost:5432/decentral_hub

# ── API Server ────────────────────────────────────────────────────────────────
PORT=8080

# ── Web (Vite dev) ────────────────────────────────────────────────────────────
WEB_PORT=5000
BASE_PATH=/
API_PROXY_TARGET=http://localhost:8080

# ── Redis (redis service) ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Security (setup-local.sh дополнит пустые ключи) ───────────────────────────
WALLET_ENCRYPTION_KEY=
JWT_SECRET=
ADMIN_SECRET=change-me-local-dev

# ── Node ──────────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Опционально (можно настроить позже) ───────────────────────────────────────
# TURN_SECRET=
# TURN_URLS=
# VIRUSTOTAL_API_KEY=
# DEFAULT_OBJECT_STORAGE_BUCKET_ID=
